# Port the API listens on
PORT=4000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/todo-app
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/todo-app?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/todo-app

# Comma separated list of origins allowed to call the API.
# Use * while developing, set your Netlify URL in production.
CORS_ORIGIN=*

# When MongoDB is unreachable the server falls back to a local JSON file
# so the app still runs in development. Set to "false" to fail hard instead.
ALLOW_FILE_FALLBACK=true
